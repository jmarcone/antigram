{
  "name": "antigram",
  "version": "0.1.0-dev",
  "private": true,
  "description": "Take your Instagram photos back from Meta. Local-only desktop tool.",
  "license": "MIT",
  "author": "Julian Marcone",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "dev": "pnpm -r --parallel --filter \"./packages/**\" dev",
    "test": "pnpm -r test",
    "test:run": "pnpm -r --workspace-concurrency=1 test -- --run",
    "typecheck": "pnpm -r typecheck",
    "parse": "pnpm --filter @antigram/cli parse",
    "reclaim": "pnpm --filter @antigram/cli reclaim",
    "fixtures:build": "pnpm --filter @antigram/parser fixtures:build",
    "build:sidecar": "pnpm --filter @antigram/cli build:sidecar",
    "tauri:dev": "pnpm build:sidecar && pnpm --filter @antigram/desktop tauri:dev",
    "tauri:build": "pnpm build:sidecar && pnpm --filter @antigram/desktop tauri:build"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.10.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
